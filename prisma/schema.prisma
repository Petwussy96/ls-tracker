// LS Tracker — Prisma schema.
// Postgres (Supabase) — DATABASE_URL goes through the connection pooler for
// runtime queries; DIRECT_DATABASE_URL is the direct connection used for
// migrations only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ============ Users + auth ============

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  displayName   String
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  avatar        String? // legacy field, mirrors `image` — we'll consolidate later
  passwordHash  String? // scrypt hash; null = existing account that hasn't set one yet
  role          String    @default("member") // "member" | "moderator" | "admin"
  joinedAt      DateTime  @default(now())

  accounts        Account[]
  sessions        Session[]
  bets            Bet[]
  createdInvites  InviteCode[] @relation("InviteCreator")
  consumedInvites InviteCode[] @relation("InviteConsumer")
  reportsFiled    BetReport[]  @relation("Reporter")
  reportsReviewed BetReport[]  @relation("Reviewer")
  feedbackSent    Feedback[]   @relation("FeedbackAuthor")
  feedbackResolved Feedback[]  @relation("FeedbackResolver")
}

// Auth.js standard tables. Names + fields must match what the Prisma adapter expects.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============ Invite codes ============

model InviteCode {
  id           String    @id @default(cuid())
  code         String    @unique
  createdAt    DateTime  @default(now())
  createdById  String
  consumedAt   DateTime?
  consumedById String?
  expiresAt    DateTime?
  note         String? // e.g. "for Klaas"

  createdBy  User  @relation("InviteCreator", fields: [createdById], references: [id])
  consumedBy User? @relation("InviteConsumer", fields: [consumedById], references: [id])

  @@index([code])
}

// ============ Bets ============
//
// BetStatus: "open" | "won" | "lost" | "void"
// BetType:   "btts" | "1x2" | "overUnder" | "handicap" | "correctScore" | "accumulator" | "other"

model Bet {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String
  combinedOdds Float
  status       String    @default("open")
  kickoff      DateTime
  placedAt     DateTime  @default(now())
  resolvedAt   DateTime?
  notes        String?
  category     String? // manual override of computeBetCategory(); null = auto

  selections Selection[]
  reports    BetReport[]

  @@index([userId])
  @@index([status])
  @@index([kickoff])
}

model Selection {
  id          String  @id @default(cuid())
  betId       String
  bet         Bet     @relation(fields: [betId], references: [id], onDelete: Cascade)
  match       String
  competition String?
  selection   String
  odds        Float
  position    Int     @default(0)

  @@index([betId])
}

// ============ Bet reports ============
//
// Members can flag a bet whose resolution (won/lost/void) looks wrong.
// At >= REPORT_THRESHOLD reports the bet shows up in /admin/reports for
// review. Reports are unique per (bet, reporter), so each user can only
// flag a given bet once.

model BetReport {
  id           String    @id @default(cuid())
  betId        String
  reporterId   String
  reason       String? // optional free-text from the reporter
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedById String?

  bet        Bet   @relation(fields: [betId], references: [id], onDelete: Cascade)
  reporter   User  @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("Reviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([betId, reporterId])
  @@index([betId])
  @@index([reviewedAt])
}

// ============ Feedback ============
//
// In-app feedback from any signed-in user. Categorized so the admin can
// triage; optional screenshot stored in Cloudinary.

model Feedback {
  id           String    @id @default(cuid())
  userId       String?
  category     String // "bug" | "parser" | "feature" | "design" | "other"
  message      String    @db.Text
  screenshot   String? // Cloudinary URL
  status       String    @default("open") // "open" | "addressed" | "wontfix"
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  user       User? @relation("FeedbackAuthor", fields: [userId], references: [id], onDelete: SetNull)
  resolvedBy User? @relation("FeedbackResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
}
