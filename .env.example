# Copy this to `.env` and adjust as needed.

# ---- Database (Supabase Postgres) ----
# Get these from Supabase dashboard → Project Settings → Database → Connection string
#   DATABASE_URL:        the "Transaction pooler" URL (port 6543, has ?pgbouncer=true)
#   DIRECT_DATABASE_URL: the "Direct connection" URL (port 5432)
DATABASE_URL="postgresql://postgres.xxxxx:[email protected]:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_DATABASE_URL="postgresql://postgres:[email protected]:5432/postgres"

# ---- Auth.js ----
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
# Public base URL of the app — used to build magic-link callback URLs.
# Locally: http://localhost:3000
# Prod:    https://luckysucker.duckdns.org (or your custom domain)
AUTH_URL="http://localhost:3000"

# ---- Email (Resend) ----
EMAIL_FROM="LS Tracker <onboarding@resend.dev>"
# If blank, magic links print to the server console (dev fallback).
# AUTH_RESEND_KEY="re_xxxxxxxxxxxx"

# ---- Image hosting (Cloudinary) ----
# Get these from Cloudinary dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Screenshot parsing runs locally via Tesseract OCR — no API key needed.
